#include <stdio.h>

  int main() {
      
     char str [50];
     int n;

     scanf("%s", str);

     scanf("%d", &n);

     int num = 0;

    for (int i = 0; i< n; i++)
        {
        int digit = str[i] + '0';

            num = num * 10 + digit;
        }
        printf("%d\n",num);
    
    
 
    return 0;
}